{
    "layer": "bottom",
    "position": "bottom",
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["clock", "tray"],
    "sway/window": {
        "max-length": 50
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S (%Z)}",
        "tooltip-format": "{tz_list}",
        "timezones": [
            "America/Los_Angeles",
            "Etc/UTC"
        ]
    },
    "tray": {
        "spacing": 10
    }
}
