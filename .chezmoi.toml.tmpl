{{- $name  := promptStringOnce . "name" "Your Name" "Miles Simpson" -}}
{{- $email := promptStringOnce . "email" "Email address" "miles@milessimpson.com" -}}
{{- $ghuser := promptStringOnce . "ghuser" "GitHub User" "heliochronix" -}}
{{- $work := promptBoolOnce . "work" "Is this a work computer" false -}}
{{- $anthropicBaseUrl := "" -}}
{{- if $work -}}
    {{- $anthropicBaseUrl = promptStringOnce . "anthropicBaseUrl" "Anthropic API base URL" -}}
{{- end -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
    {{- $osid = printf "%s-%s" $osid .chezmoi.osRelease.id -}}
    {{- if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
        {{- $osid = printf "%s-wsl" $osid -}}
    {{- end -}}
{{- end -}}

[data]
    name  = {{ $name  | quote }}
    email = {{ $email | quote }}
    ghuser = {{ $ghuser | quote }}
    osid  = {{ $osid  | quote }}
    work  = {{ $work }}
{{- if $work }}
    anthropicBaseUrl = {{ $anthropicBaseUrl | quote }}
{{- end }}
